{
  "name": "polymarket-bot-api",
  "module": "src/dev-server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/dev-server.ts",
    "start": "bun src/dev-server.ts",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "vercel-build": "prisma generate && npm run build:vercel",
