
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionAction {
  START_TRADE
  END_TRADE
  WAIT
  SKIP
}

model User {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @unique
  password             String
  preferences          Json
  onboardingCompleted  Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  botConfig   BotConfig?
  userConfig  UserConfig?
  sessions    Session[]
}

model BotConfig {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxOrderSizeUsdc Int
  maxExposureUsdc  Int
  allowedSides     String[]
  minPrice         Float
  maxPrice         Float
  dryRun           Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  polymarketApiKey    String?
  polymarketApiSecret String?
  aiApiKey            String?
  aiApiProvider       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  pages     Json?
  metadata  Json?
  userId    String
  user      User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  stages    SessionStage[]
}

model SessionStage {
  id                   String         @id @default(uuid()) @db.Uuid
  sessionId            String         @db.Uuid
  session              Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence             Int
  summary              String
  todo                 String
  sessionAction        SessionAction
  stageActionCompleted Boolean        @default(false)
  nextWake             DateTime
  prevStageId          String?        @db.Uuid
  prevStage            SessionStage?  @relation("SessionStageChain", fields: [prevStageId], references: [id], onDelete: SetNull)
  nextStages           SessionStage[] @relation("SessionStageChain")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@index([sessionId, nextWake])
}
